generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Competition {
  id                      Int           @id @default(autoincrement())
  competitionId           String        @unique
  name                    String

  games                   Game[]
}

model Club {
  id                      Int           @id @default(autoincrement())
  clubId                  Int           @unique
  name                    String
  isNationalTeam          Boolean?

  homeGames               Game[]        @relation("HomeClub")
  awayGames               Game[]        @relation("AwayClub")
  appearances             Appearance[]
}

model Player {
  id                      Int           @id @default(autoincrement())
  playerId                Int           @unique
  name                    String
  displayName             String?
  position                String?
  subPosition             String?

  appearances             Appearance[]
}

model Game {
  id                      Int           @id @default(autoincrement())
  gameId                  Int           @unique
  competitionId           String
  season                  Int?
  round                   String?
  date                    DateTime?
  homeClubId              Int
  awayClubId              Int
  targetTeamId            Int
  opponentTeamId          Int
  homeClubGoals           Int?
  awayClubGoals           Int?
  homeClubFormation       String?
  awayClubFormation       String?
  stadium                 String?

  competition             Competition   @relation(fields: [competitionId], references: [competitionId])
  homeClub                Club?         @relation("HomeClub", fields: [homeClubId], references: [clubId])
  awayClub                Club?         @relation("AwayClub", fields: [awayClubId], references: [clubId])
  appearances             Appearance[]

  @@index([competitionId])
}

model Appearance {
  id                      Int           @id @default(autoincrement())
  gameId                  Int
  clubId                  Int       
  playerId                Int       
  number                  Int?
  type                    String
  position                String?
  isCaptain               Boolean?
  goals                   Int           @default(0)
  assists                 Int           @default(0)
  redCards                Int           @default(0)

  match                   Game          @relation(fields: [gameId], references: [gameId])
  player                  Player        @relation(fields: [playerId], references: [playerId])
  club                    Club          @relation(fields: [clubId], references: [clubId])

  @@unique([gameId, playerId])
  @@index([gameId])
}