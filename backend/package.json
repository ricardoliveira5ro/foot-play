{
  "name": "backend",
  "version": "0.2.3",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node --project prisma/tsconfig.json prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16",
    "express": "^4.22",
    "morgan": "^1.12.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/cors": "^2.8",
    "@types/express": "^5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "prisma": "^7.9.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "ts-node": "^10",
    "ts-node-dev": "^2",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
