{
  "name": "footplay",
  "version": "0.1.0",
  "private": true,
  "description": "FootPlay — Football data platform",
  "workspaces": [
    "frontend",
    "backend",
    "scripts"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "build": "echo 'Build will be wired per workspace'",
    "lint": "npm run lint -w frontend && ESLINT_USE_FLAT_CONFIG=false eslint backend/src/",
    "format": "prettier --write .",
    "data-pipeline": "npx -w scripts ts-node src/download-data.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "@typescript-eslint/parser": "^8",
    "@typescript-eslint/eslint-plugin": "^8",
    "prettier": "^3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
